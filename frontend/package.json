{
  "name": "food-journal-nyc-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.8"
  }
}
